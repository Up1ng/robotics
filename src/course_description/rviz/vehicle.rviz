Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Plane: XY
      Cell Size: 0.2
      Plane Cell Count: 20
      Reference Frame: base_link
      Offset: {X: 0, Y: 0, Z: -0.12}
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Links:
        All Links Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Marker Scale: 0.15
      Frames:
        All Enabled: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 35; 39; 47
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.5
      Focal Point: {X: 0, Y: 0, Z: 0.12}
      Pitch: 0.5
      Yaw: 0.7
Window Geometry:
  Width: 1200
  Height: 850
  X: 0
  Y: 0
